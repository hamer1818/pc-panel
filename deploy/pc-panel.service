# PC Panel — ESP32-S3 ekran kartı servisi (systemd kullanıcı servisi)
# Kurulum: deploy/kur.sh (@KOK@ yerine proje klasörünü yazar)   ·   Günlük: journalctl --user -u pc-panel -f
[Unit]
Description=PC Panel - ESP32-S3 ekran karti servisi
Documentation=file://@KOK@/docs/02-mimari.md
# Masaüstü oturumu (D-Bus, Wayland, PipeWire) hazır olunca başla, oturum kapanınca dur
After=graphical-session.target pipewire.service wireplumber.service
PartOf=graphical-session.target
# Proje klasörünün bulunduğu disk bağlanmadan başlama
RequiresMountsFor=@KOK@/host

[Service]
Type=simple
WorkingDirectory=@KOK@/host
ExecStart=@KOK@/host/.venv/bin/pc-panel
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
# Kapanırken karta "bye" gönderip ekranı karartabilsin
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
